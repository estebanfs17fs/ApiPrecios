DATABASE_URL=sqlite:///precios_uy.db
SCRAP_INTERVAL_HOURS=6
API_HOST=0.0.0.0
API_PORT=8000
REQUEST_TIMEOUT=30
LOG_LEVEL=INFO
LOG_FILE=precios_uy.log
CACHE_TTL_HOURS=6

# Navegador para Disco y Devoto (scroll infinito)
# CHROMIUM_PATH=            # vacío = el Chromium que instala `playwright install chromium`
BROWSER_HEADLESS=true
SCROLL_MAX_PASOS=400
SCROLL_PACIENCIA=5
SCROLL_ESPERA_MS=4000
